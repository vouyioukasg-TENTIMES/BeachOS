# Copy this file to .env for local infrastructure only.
# Never commit real credentials. Replace all local-only values before use.

COMPOSE_PROJECT_NAME=emerald-management-system
POSTGRES_DB=emerald_local
POSTGRES_USER=emerald_local
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://emerald_local:change-this-local-password@localhost:5432/emerald_local

# Application settings are examples for future implementation.
APP_ENV=development
APP_TIMEZONE=Europe/Athens
APP_CURRENCY=EUR
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=5173
