{
  "name": "beachos-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Engineering workspace for the BeachOS Platform",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "check:foundation": "./scripts/check-foundation.sh",
    "format": "prettier --write package.json pnpm-workspace.yaml apps/web",
    "format:check": "prettier --check package.json pnpm-workspace.yaml apps/web",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "build": "pnpm --recursive --if-present build"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
